# Read-only multi-market scanner configuration
MARKET_REGISTRY_PATH=market_registry.json
CHECK_INTERVAL_SECONDS=15

# Public CEX market data only; no API keys or private permissions are required.
KUCOIN_BASE_URL=https://api.kucoin.com

# Public RPC examples for read-only DRY_RUN validation.
# Replace with your own reliable/provider RPCs if rate-limited.
ZILLIQA_RPC_URL=https://public.moonlet.cloud/zilliqa
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
AVALANCHE_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com
