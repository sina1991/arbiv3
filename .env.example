# Multi-network discovery. GeckoTerminal network IDs.
SCANNER_NETWORKS=zilliqa,eth,bsc,polygon_pos,arbitrum,optimism,base

# Requested capital test points (USDT).
TRADE_SIZES_USDT=100,250,500,1000,2500,5000

# Candidate quote assets and discovery filters.
SCANNER_QUOTE_SYMBOLS=USDT,USDC,DAI,WETH,WBNB
MIN_POOL_LIQUIDITY_USD=10000
DISCOVERY_LIMIT_PER_NETWORK=20
SCAN_INTERVAL_SECONDS=60
SCANNER_REPORT_PATH=reports/latest-markets.json
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# RPC endpoints are intentionally not guessed. Configure verified endpoints
# per chain before enabling on-chain quote adapters.
ZILLIQA_RPC_URL=https://public.moonlet.cloud/zilliqa
ETHEREUM_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=

# CEX mappings must be explicitly verified for each token.
KUCOIN_BASE_URL=https://api.kucoin.com
